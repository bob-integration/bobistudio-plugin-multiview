{
  "license": "GPL-3.0-or-later",
  "type": "multiview",
  "runtime": "docker",
  "label": "Multiviewer",
  "badge": {
    "label": "Multiviewer",
    "class": "mode-multiview",
    "oklch": "0.77 0.07 306"
  },
  "skaarhoj": {
    "mode": "multiview",
    "desc_i18n": "settings.js.skh_desc_multiview"
  },
  "deploy_order": 1,
  "resources": {
    "cores": 3,
    "memory": 2048,
    "pin": true,
    "gpu": 1
  },
  "version": "0.76.1",
  "settings_panel": false,
  "adapts_input": true,
  "description": "Multiviewer : N entrées vidéo disposées librement (position/taille/label/tally) → 1 sortie composite. Layout via le composer ; sources câblées à chaud.",
  "nav": {
    "section": "traitements",
    "label": "Traitements",
    "route": "/traitements/multiview",
    "order": 10
  },
  "script_template": "script.py",
  "ui": {
    "control_html": "control.html",
    "control_js": "control.js",
    "extra_js": "multiview.js",
    "extra_css": "multiview.css",
    "monitoring_html": "monitoring.html",
    "monitoring_js": "monitoring.js"
  },
  "monitoring": {
    "label": "Détail Multiviews",
    "order": 10,
    "when": "instances"
  },
  "deploy_defaults": {
    "flux_config": [],
    "meter_blocks": [],
    "video_history_blocks": [],
    "audio_history_blocks": [],
    "overlays": [],
    "shm_out": "mxl_mix",
    "genlock": true,
    "tsl_mode": "central",
    "tsl_port": 0,
    "max_inputs": 4,
    "show_no_signal": true,
    "freeze_detect_s": 2.0,
    "show_proxy": false,
    "orientation": "landscape",
    "log_level": "info"
  },
  "config_schema": [
    {
      "key": "orientation",
      "type": "select",
      "label": "Orientation",
      "default": "landscape",
      "options": [
        {
          "value": "landscape",
          "label": "Paysage"
        },
        {
          "value": "portrait_cw",
          "label": "Portrait ↻ (horaire)"
        },
        {
          "value": "portrait_ccw",
          "label": "Portrait ↺ (anti-horaire)"
        }
      ],
      "hidden": true,
      "help": "Réglé depuis le composer du mur."
    },
    {
      "key": "shm_out",
      "type": "text",
      "label": "SHM sortie",
      "placeholder": "mxl_mix",
      "default": "mxl_mix"
    },
    {
      "key": "max_inputs",
      "type": "number",
      "label": "Max entrées",
      "min": 1,
      "max": 16,
      "default": 4,
      "hidden": true,
      "help": "Réglé depuis le composer du mur."
    },
    {
      "key": "show_no_signal",
      "type": "bool",
      "label": "Afficher « NO SIGNAL » quand la source manque",
      "default": true,
      "scope": "user"
    },
    {
      "key": "freeze_detect_s",
      "type": "number",
      "label": "Détection image figée (s, 0 = off)",
      "min": 0,
      "max": 30,
      "default": 2,
      "scope": "user"
    },
    {
      "key": "tsl_mode",
      "type": "select",
      "label": "Source du tally/UMD",
      "options": [
        {
          "value": "central",
          "label": "Centralisé (service TSL orchestrateur)"
        },
        {
          "value": "direct",
          "label": "TSL Direct (serveur local du multiview)"
        }
      ],
      "default": "central"
    },
    {
      "key": "tsl_port",
      "type": "number",
      "label": "Port TSL 5.0 local (mode Direct uniquement)",
      "min": 0,
      "max": 65535,
      "default": 0
    },
    {
      "key": "cadence",
      "hidden": true,
      "type": "select",
      "label": "Cadence de composition",
      "help": "genlock : attend la grille PTP (défaut). input : émet dès qu'une entrée a une nouvelle trame (étage intermédiaire d'un tissu, whole-frame). flow : tissu en tranches — cible l'index d'epoch, exige le mode tranche éligible.",
      "default": "genlock",
      "scope": "system",
      "options": [
        {
          "value": "genlock",
          "label": "Genlock (grille PTP — défaut)"
        },
        {
          "value": "input",
          "label": "Input (data-driven, étage intermédiaire)"
        },
        {
          "value": "flow",
          "label": "Flow (tissu en tranches)"
        }
      ]
    },
    {
      "key": "slice_mode",
      "hidden": true,
      "type": "checkbox",
      "label": "Mode tranche (latence sous-image)",
      "help": "La vidéo est publiée bande par bande sur le bus MXL : l'aval démarre sur la première bande sans attendre l'image complète (latence sous-image). Entrelacé ou hauteur non divisible → repli image entière. Désactivé (défaut) = comportement historique. CPU (GPU : voir Tranche GPU), paysage seulement.",
      "default": false,
      "scope": "system"
    },
    {
      "key": "slice_lines",
      "hidden": true,
      "type": "number",
      "label": "Lignes par tranche",
      "help": "Hauteur des bandes (lignes). Doit être un diviseur de la hauteur d'image (36 pour 1080p) — sinon repli image entière.",
      "min": 4,
      "max": 540,
      "default": 36,
      "scope": "system",
      "visible_if": {
        "slice_mode": true
      }
    },
    {
      "key": "gpu_slice",
      "hidden": true,
      "type": "checkbox",
      "label": "Tranche GPU (opt-in banc)",
      "help": "Lève l'exclusion GPU du mode tranche : composition bande par bande en VRAM. Ne pas activer en prod sans le verdict du banc gate (TISSU_SLICE_GPU.md).",
      "default": false,
      "scope": "system",
      "visible_if": {
        "slice_mode": true
      }
    },
    {
      "key": "gpu_batch_bands",
      "hidden": true,
      "type": "number",
      "label": "Bandes par lot GPU (micro-batch)",
      "help": "Nombre de bandes MXL par lot GPU (verdict banc GO-MEGA-135 : 4 ≈ méga-bandes 144 lignes à 1080p/36). 1 = bande à bande.",
      "min": 1,
      "max": 8,
      "default": 4,
      "scope": "system",
      "visible_if": {
        "gpu_slice": true
      }
    },
    {
      "key": "log_level",
      "type": "select",
      "label": "Niveau de log",
      "help": "Verbosité du journal du conteneur. Défaut « Événements » : les faits marquants (démarrage/arrêt, changement de format, reconnexion, repli sur un chemin dégradé, entrée qui apparaît ou disparaît) sont TOUJOURS écrits — après une panne le journal doit permettre de reconstituer l'histoire, et élever le niveau après coup ne récupère rien. Les métriques périodiques (fps, compteurs) ne sont PAS journalisées : elles sont déjà publiées sur :8080. « Détaillé » = lance-flammes par trame, à n'activer que le temps d'un diagnostic (le journal Docker n'est pas roté).",
      "options": [
        {
          "value": "debug",
          "label": "Détaillé (par trame — diagnostic ponctuel)"
        },
        {
          "value": "info",
          "label": "Événements (défaut)"
        },
        {
          "value": "warning",
          "label": "Anomalies seules"
        },
        {
          "value": "error",
          "label": "Erreurs seules"
        }
      ],
      "default": "info",
      "scope": "user"
    },
    {
      "key": "scale_filter",
      "type": "select",
      "label": "Filtre de réduction des vignettes",
      "help": "Une vignette est une réduction de sa source (1920×1080 dans une case 640×360 = 1 pixel sur 9). « Moyenne » filtre correctement : le texte incrusté et les détails fins de la source redeviennent lisibles. « Décimation » est le comportement historique, plus rapide mais crénelé. La moyenne coûte environ 10× plus de CPU par vignette — surveiller compose_breakdown_ms.inputs sur :8080.",
      "default": "box",
      "scope": "system",
      "options": [
        {
          "value": "box",
          "label": "Moyenne du bloc (anticrénelage)"
        },
        {
          "value": "nearest",
          "label": "Décimation (historique, rapide)"
        }
      ]
    },
    {
      "key": "interlace_mode",
      "type": "select",
      "label": "Sources entrelacées",
      "help": "Le mur sort toujours en progressif : une source 1080i doit être désentrelacée. « Tissage » recompose les deux champs et rend la résolution verticale complète — c'est le réglage qui rend les incrustations de la source lisibles. « Champ seul » est le comportement historique : moitié de la résolution verticale, mais insensible au mouvement. Le tissage peigne sur les mouvements rapides ; la réduction vers la vignette en absorbe l'essentiel.",
      "default": "weave",
      "scope": "system",
      "options": [
        {
          "value": "weave",
          "label": "Tissage des deux champs (résolution pleine)"
        },
        {
          "value": "bob",
          "label": "Champ seul (historique)"
        }
      ]
    },
    {
      "key": "mvk",
      "type": "bool",
      "default": true,
      "label": "Noyau de composition fusionné (C)",
      "help": "Accélère la composition de 4,8 à 6,2×. À DÉSACTIVER si le mur meurt en « code -11 » (SIGSEGV) : le repli numpy est l'ancien chemin, bit-exact — on y perd de la vitesse, jamais de la justesse. Prend effet au redéploiement du script."
    }
  ],
  "wiring": {
    "produces": [
      {
        "essence": "video",
        "shm": "{shm_out}"
      }
    ],
    "consumes": [
      {
        "from_list": "flux_config",
        "essence": "video",
        "shm_field": "path",
        "shm_prefix": "/dev/shm/",
        "name_field": "name",
        "dims_fields": [
          "in_w",
          "in_h"
        ],
        "existing_only": true,
        "input_key": "idx"
      },
      {
        "from_list": "flux_config",
        "essence": "audio",
        "shm_field": "audio_path",
        "shm_prefix": "/dev/shm/",
        "existing_only": true,
        "input_key": "idx",
        "optional": true,
        "label": "Audio {i1}"
      },
      {
        "from_list": "flux_config",
        "essence": "data",
        "shm_field": "anc_path",
        "shm_prefix": "/dev/shm/",
        "existing_only": true,
        "input_key": "idx",
        "optional": true,
        "label": "ANC {i1}"
      },
      {
        "from_list": "meter_blocks",
        "essence": "audio",
        "shm_field": "audio_path",
        "shm_prefix": "/dev/shm/",
        "existing_only": true,
        "input_key": "block_idx",
        "optional": true,
        "label": "VU mur {i1}"
      },
      {
        "from_list": "video_history_blocks",
        "essence": "video",
        "shm_field": "path",
        "shm_prefix": "/dev/shm/",
        "existing_only": true,
        "input_key": "vh_idx",
        "optional": true,
        "label": "Hist. vidéo {i1}"
      },
      {
        "from_list": "audio_history_blocks",
        "essence": "audio",
        "shm_field": "audio_path",
        "shm_prefix": "/dev/shm/",
        "existing_only": true,
        "input_key": "ah_idx",
        "optional": true,
        "label": "Hist. audio {i1}"
      }
    ],
    "mode": "hot-wire",
    "state_endpoint": "/input"
  },
  "control": {
    "endpoints": [
      "/input",
      "/state",
      "/window",
      "/style",
      "/reconfigure",
      "/overlays",
      "/chrono",
      "/overlay_text",
      "/log_level",
      "/clock_tz",
      "/telemetry"
    ],
    "read_endpoints": [
      "/state",
      "/chronos",
      "/texts",
      "/timezones"
    ],
    "recall": {
      "source": "layouts",
      "scope": "global",
      "endpoint": "/window"
    }
  },
  "param_tree": {
    "boxes": {
      "count_from": "n_windows",
      "path_prefix": "windows",
      "idx": "idx",
      "label": "PiP"
    },
    "box_groups": [
      {
        "label": "Position / taille",
        "endpoint": "/window",
        "caps": "window_fields",
        "fields": {
          "x": {
            "label": "Position X",
            "type": "pixels"
          },
          "y": {
            "label": "Position Y",
            "type": "pixels"
          },
          "w": {
            "label": "Largeur",
            "type": "pixels"
          },
          "h": {
            "label": "Hauteur",
            "type": "pixels"
          }
        }
      },
      {
        "label": "Affichage",
        "endpoint": "/window",
        "fields": {
          "show_label": {
            "label": "Afficher le nom",
            "type": "bool",
            "default": true
          },
          "show_tally": {
            "label": "Afficher le tally",
            "type": "bool",
            "default": true
          },
          "hidden": {
            "label": "Masquer la fenêtre",
            "type": "bool",
            "default": false
          }
        }
      },
      {
        "label": "VU-mètres",
        "endpoint": "/window",
        "caps": "window_fields",
        "fields": {
          "meter_opacity": {
            "label": "Opacité des VU",
            "type": "percent"
          },
          "meter_inside": {
            "label": "VU à l'intérieur de l'image",
            "type": "bool",
            "default": false
          }
        }
      },
      {
        "label": "TSL",
        "endpoint": "/window",
        "caps": "window_fields",
        "fields": {
          "tsl_index": {
            "label": "Index TSL",
            "type": "number"
          }
        }
      }
    ],
    "global_groups": [
      {
        "label": "Affichage des sources",
        "endpoint": "/style",
        "fields": {
          "show_no_signal": {
            "label": "Afficher « NO SIGNAL » si source absente",
            "type": "bool",
            "default": true
          },
          "freeze_detect_s": {
            "label": "Détection image figée (s, 0 = off)",
            "type": "number",
            "min": 0,
            "max": 30,
            "default": 2
          },
          "show_proxy": {
            "label": "Badge proxy (pyramide)",
            "type": "bool",
            "default": false
          }
        }
      },
      {
        "label": "Journal (diagnostic)",
        "endpoint": "/log_level",
        "fields": {
          "level": {
            "label": "Niveau de log",
            "type": "enum",
            "options": [
              "debug",
              "info",
              "warning",
              "error"
            ],
            "default": "info",
            "path": "log_level"
          }
        }
      }
    ]
  },
  "actions": [
    {
      "id": "chrono_start",
      "label": "Démarrer l'horloge",
      "endpoint": "/chrono",
      "body": {
        "action": "start"
      },
      "params": [
        {
          "key": "id",
          "label": "Horloge",
          "options_endpoint": "/chronos"
        }
      ]
    },
    {
      "id": "chrono_stop",
      "label": "Arrêter l'horloge",
      "endpoint": "/chrono",
      "body": {
        "action": "stop"
      },
      "params": [
        {
          "key": "id",
          "label": "Horloge",
          "options_endpoint": "/chronos"
        }
      ]
    },
    {
      "id": "chrono_reset",
      "label": "Remettre l'horloge à zéro",
      "endpoint": "/chrono",
      "body": {
        "action": "reset"
      },
      "params": [
        {
          "key": "id",
          "label": "Horloge",
          "options_endpoint": "/chronos"
        }
      ]
    },
    {
      "id": "set_text",
      "label": "Changer le texte",
      "endpoint": "/overlay_text",
      "params": [
        {
          "key": "id",
          "label": "Champ texte",
          "options_endpoint": "/texts"
        },
        {
          "key": "text",
          "label": "Texte",
          "type": "text"
        }
      ]
    },
    {
      "id": "tally",
      "label": "Tally d'une fenêtre",
      "endpoint": "/tally",
      "port": 8080,
      "params": [
        {
          "key": "flux_idx",
          "label": "Fenêtre",
          "type": "number",
          "default": 0,
          "options_from": "inputs"
        },
        {
          "key": "color",
          "label": "Couleur",
          "type": "text",
          "default": "red",
          "options": [
            {
              "value": "red",
              "label": "Rouge (antenne)"
            },
            {
              "value": "green",
              "label": "Vert (préparation)"
            },
            {
              "value": "off",
              "label": "Éteint"
            }
          ]
        }
      ]
    },
    {
      "id": "recall_layout",
      "label": "Rappeler un layout",
      "core": "recall",
      "params": [
        {
          "key": "memory",
          "label": "Layout",
          "type": "number",
          "options_from": "recall"
        }
      ]
    },
    {
      "id": "log_level",
      "label": "Niveau de log (à chaud)",
      "endpoint": "/log_level",
      "params": [
        {
          "key": "level",
          "label": "Niveau",
          "type": "text",
          "default": "info",
          "options": [
            {
              "value": "debug",
              "label": "Détaillé"
            },
            {
              "value": "info",
              "label": "Événements (défaut)"
            },
            {
              "value": "warning",
              "label": "Anomalies seules"
            },
            {
              "value": "error",
              "label": "Erreurs seules"
            }
          ]
        }
      ]
    },
    {
      "id": "set_clock_tz",
      "label": "Changer le fuseau d'une horloge",
      "endpoint": "/clock_tz",
      "params": [
        {
          "key": "id",
          "label": "Horloge",
          "options_endpoint": "/chronos"
        },
        {
          "key": "tz",
          "label": "Fuseau horaire",
          "options_endpoint": "/timezones"
        }
      ]
    }
  ],
  "video_format": false
}
