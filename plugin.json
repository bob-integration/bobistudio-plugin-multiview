{
  "license": "GPL-3.0-or-later",
  "type": "multiview",
  "runtime": "docker",
  "label": "Multiviewer",
  "badge": {
    "label": "Multiviewer",
    "class": "mode-multiview",
    "oklch": "0.77 0.07 306"
  },
  "skaarhoj": {"mode": "multiview", "desc_i18n": "settings.js.skh_desc_multiview"},
  "deploy_order": 1,
  "resources": {"cores": 3, "memory": 2048, "pin": true},
  "version": "0.14.28",
  "adapts_input": true,
  "description": "Multiviewer : N entrées vidéo disposées librement (position/taille/label/tally) → 1 sortie composite. Layout via le composer ; sources câblées à chaud.",
  "nav": {
    "section": "traitements",
    "label": "Traitements",
    "route": "/traitements/multiview",
    "order": 10
  },
  "script_template": "script.py",
  "ui": {
    "control_html": "control.html",
    "control_js": "control.js",
    "extra_js": "multiview.js",
    "extra_css": "multiview.css"
  },
  "deploy_defaults": {
    "flux_config": [],
    "overlays": [],
    "shm_out": "mxl_mix",
    "genlock": true,
    "border_w": 0,
    "border_color": "#ffffff",
    "overlay_below": false,
    "label_size": 14,
    "tsl_port": 0,
    "max_inputs": 4,
    "frame_style": "none",
    "show_no_signal": true,
    "freeze_detect_s": 2.0,
    "show_format": false,
    "show_proxy": false
  },
  "config_schema": [
    {
      "key": "shm_out",
      "type": "text",
      "label": "SHM sortie",
      "placeholder": "mxl_mix",
      "default": "mxl_mix"
    },
    {
      "key": "max_inputs",
      "type": "number",
      "label": "Max entrées",
      "min": 1,
      "max": 16,
      "default": 4
    },
    {
      "key": "border_w",
      "type": "number",
      "label": "Bordure (px)",
      "min": 0,
      "max": 30,
      "default": 0
    },
    {
      "key": "border_color",
      "type": "text",
      "label": "Couleur bordure",
      "placeholder": "#ffffff",
      "default": "#ffffff"
    },
    {
      "key": "label_size",
      "type": "number",
      "label": "Taille label (px)",
      "min": 6,
      "max": 80,
      "default": 14
    },
    {
      "key": "frame_style",
      "type": "select",
      "label": "Style de cadre",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "Aucun (bordure simple)"
        },
        {
          "value": "stylized",
          "label": "Moniteur (bezel)"
        },
        {
          "value": "classic",
          "label": "UMD broadcast"
        },
        {
          "value": "tally_border",
          "label": "Cadre tally"
        },
        {
          "value": "viewfinder",
          "label": "Viseur (coins)"
        },
        {
          "value": "flat",
          "label": "Flat (soulignement)"
        }
      ]
    },
    {
      "key": "show_no_signal",
      "type": "bool",
      "label": "Afficher « NO SIGNAL » quand la source manque",
      "default": true
    },
    {
      "key": "freeze_detect_s",
      "type": "number",
      "label": "Détection image figée (s, 0 = off)",
      "min": 0,
      "max": 30,
      "default": 2
    },
    {
      "key": "show_format",
      "type": "bool",
      "label": "Afficher le format source par fenêtre",
      "default": false
    },
    {
      "key": "tsl_port",
      "type": "number",
      "label": "Port TSL 5.0 (0 = off, ignoré si TSL orchestrateur activé)",
      "min": 0,
      "max": 65535,
      "default": 0
    },
    {
      "key": "tsl_remote",
      "type": "bool",
      "label": "TSL géré par l'orchestrateur (service centralisé)",
      "default": false
    }
  ],
  "wiring": {
    "produces": [
      {
        "essence": "video",
        "shm": "{shm_out}"
      }
    ],
    "consumes": [
      {
        "from_list": "flux_config",
        "essence": "video",
        "shm_field": "path",
        "shm_prefix": "/dev/shm/",
        "name_field": "name",
        "dims_fields": [
          "in_w",
          "in_h"
        ],
        "existing_only": true,
        "input_key": "idx"
      }
    ],
    "mode": "hot-wire",
    "state_endpoint": "/input"
  },
  "control": {
    "endpoints": [
      "/input",
      "/state",
      "/window",
      "/style",
      "/reconfigure",
      "/overlays",
      "/chrono"
    ],
    "recall": {
      "source": "layouts",
      "scope": "global",
      "endpoint": "/window"
    }
  }
}